# =============================================================================
# Max Pay Ads — Frontend Environment Variables
# Copy this file to .env.local for local development.
# =============================================================================

# Backend API URL (used by Next.js rewrites at build time and runtime)
# Docker: http://fastapi:8000   Local dev: http://localhost:8000
NEXT_BACKEND_URL=http://localhost:8000

# =============================================================================
# Conditional Entry Access — Protected Landing Flow
# =============================================================================
# Comma-separated list of allowed referring domains (full origin URLs).
# Only visitors arriving via a link on these domains are granted access.
# Example: "https://browsmac.org,https://www.browsmac.org"
# Leave blank to disable the entry guard entirely.
ALLOWED_ENTRY_DOMAINS=

# Where to redirect visitors who fail the entry check.
# Must be an external URL — never set this to your own domain (causes loop).
ENTRY_FALLBACK_URL=https://www.google.com/

# Session lifetime in seconds (default: 900 = 15 minutes).
# After this period the cookie expires and the visitor must arrive via an
# allowed referrer again.
ENTRY_SESSION_TTL=900

# HMAC-SHA256 signing secret for session tokens.
# Generate with:  openssl rand -hex 32
# NEVER commit the real value. NEVER expose in client-side code.
# If blank, the entry guard is disabled (useful for local dev).
ENTRY_SESSION_SECRET=

# =============================================================================
# Source-View Deterrent Feature
# =============================================================================
# Enable/disable the source-view deterrent service worker.
# When enabled, view-source navigations are redirected to show the rendered page.
# Set to 'false' to completely disable the feature.
# Note: This is a deterrent only - it does not prevent access to source via
# DevTools, curl, or other methods.
ENABLE_SOURCE_DETERRENT=true
