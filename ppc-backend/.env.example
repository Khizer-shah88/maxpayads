# ============================================
# Max Pay Ads — Environment Configuration
# Copy this file to .env and fill in values
# ============================================

APP_NAME=Max Pay Ads
APP_VERSION=1.0.0
DEBUG=false

# JWT Authentication
SECRET_KEY=CHANGE_ME_to_a_long_random_string_at_least_32_chars

# Prelander authorization sessions (security: DOMAIN != AUTHORIZATION).
# Lifetime in seconds for the click-time authorization that grants access to
# protected prelander content. Default 300 (5 minutes).
PRELANDER_SESSION_TTL=300
# One-time cross-domain handoff validity (seconds) — the token exchanged at
# prelander/_auth/{token} for the prelander-domain session cookie.
# Short by design. Default 60.
PRELANDER_HANDOFF_TTL=60
# Set to false ONLY to temporarily disable the prelander authorization gate
# (emergency rollback valve). Default true (enabled).
PRELANDER_AUTH_REQUIRED=true
# Denied prelander access fallback (STEP 6): generic_page | not_found |
# forbidden | redirect
PRELANDER_DENIED_MODE=generic_page
# Target for redirect mode (a safe public URL — never the campaign)
PRELANDER_DENIED_FALLBACK_URL=
# IP-usage policy (STEP 12): relaxed (default — UA-bound, IP is a signal) | strict (full IP+UA fingerprint)
PRELANDER_IP_MODE=relaxed
# Cookie flags (STEP 13): HttpOnly is always enforced; these control Secure +
# SameSite for both prelander cookies (mpa_pla anchor reference, mpa_pls
# browsing session). SameSite: lax | strict | none (none requires Secure).
PRELANDER_COOKIE_SECURE=true
PRELANDER_COOKIE_SAMESITE=lax
# Anti-abuse (STEP 15): per-IP limit on the prelander auth token surfaces
# (handoff mint + exchange) — 30 requests per 60s window by default.
PRELANDER_AUTH_RATE_LIMIT=30
PRELANDER_AUTH_RATE_WINDOW=60
# Smartlink signing: when true, /click REJECTS links without a valid HMAC
# token (legacy token-less links stop working). Default false — links that
# CARRY a token are always verified regardless of this flag.
SMARTLINK_HASH_REQUIRED=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DB_NAME=ppc_network

# Redis
REDIS_URL=redis://localhost:6379

# Celery + RabbitMQ
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Default Admin Account (created by seed_admin.py)
ADMIN_EMAIL=admin@maxpayads.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Super Admin

# GeoIP Database (MaxMind GeoLite2)
GEOIP_DB_PATH=./GeoLite2-Country.mmdb

# CPC & Revenue
DEFAULT_CPC=0.05
DEFAULT_REVENUE_SHARE=0.80

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Withdrawal
MIN_WITHDRAWAL_AMOUNT=10.0

# Redirection Domains — server public IP for DNS verification
SERVER_PUBLIC_IP=
